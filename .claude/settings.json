{
  "permissions": {
    "allow": [
      "Read", "Write", "Edit", "Grep", "Glob",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(git mv:*)", "Bash(git rm:*)",
      "Bash(npm run build:*)", "Bash(npm install:*)", "Bash(npm ci:*)",
      "Bash(date:*)", "Bash(wc:*)", "Bash(sha1sum:*)"
    ],
    "deny": ["Bash(rm -rf:*)"],
    "additionalDirectories": ["../"]
  }
}
